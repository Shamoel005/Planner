<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TODAY"
        android:textColor="#D71921"
        android:textSize="11sp"
        android:textStyle="bold"
        android:typeface="monospace" />

    <TextView
        android:id="@+id/w_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:typeface="monospace" />

    <TextView android:id="@+id/w1" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFF" android:textSize="14sp" android:typeface="monospace" />
    <TextView android:id="@+id/w2" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFF" android:textSize="14sp" android:typeface="monospace" />
    <TextView android:id="@+id/w3" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFF" android:textSize="14sp" android:typeface="monospace" />
    <TextView android:id="@+id/w4" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFF" android:textSize="14sp" android:typeface="monospace" />
    <TextView android:id="@+id/w5" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="#FFFFFF" android:textSize="14sp" android:typeface="monospace" />

    <TextView
        android:id="@+id/w_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="All clear."
        android:textColor="#8C8C8C"
        android:textSize="14sp"
        android:typeface="monospace" />
</LinearLayout>
